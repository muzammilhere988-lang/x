# Supabase Configuration (Required)
# Find these in Supabase Dashboard -> Project Settings -> API
# Note: Only use your Project URL and Publishable (anon) key here.
# NEVER put your Supabase service_role secret key in any VITE_ variable.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-publishable-anon-key"

# Optional Production Menu URL (Used as fallback before configured in Admin Settings)
# Example: https://yourdomain.com/menu
VITE_PUBLIC_MENU_BASE_URL=""
